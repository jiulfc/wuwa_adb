{
  "version": 3,
  "label": "switch role if full",
  "vars": {
    "circle_percent": 0
  },
  "steps": [
    {
      "type": "circle_percentage",
      "label": "Measure and log the colored ring",
      "roi": [1270, 1270, 72, 72],
      "profile": "default",
      "output": "${circle_percent}"
    },
    {
      "type": "if",
      "condition": "${circle_percent >= 1}",
      "then": [
        {
          "type": "tap",
          "point": [2866, 366],
          "duration_ms": 100
        },
        {
          "type": "wait",
          "wait_ms": 500
        }
      ]
    }
  ]
}
