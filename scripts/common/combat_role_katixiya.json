{
  "version": 3,
  "label": "Katixiya combo with opportunistic S: A, A, A, Heavy A, E, A",
  "vars": {
    "cycle": 0,
    "max_cycles": 200,
    "combo_step": 0,
    "skill_state": null,
    "lock_point": [955, 1220],
    "a_point": [2571, 1123],
    "lock_tap_ms": 100,
    "s_tap_ms": 100,
    "a_1_tap_ms": 100,
    "a_2_tap_ms": 100,
    "a_3_tap_ms": 200,
    "heavy_a_tap_ms": 1000,
    "e_tap_ms": 100,
    "a_4_tap_ms": 100,
    "current_tap_ms": 100,
    "a_roi": [2448, 1000, 240, 240],
    "s_roi": [2276, 936, 72, 72],
    "e_roi": [2276, 1188, 144, 144]
  },
  "steps": [
    {
      "type": "while",
      "label": "Run at most 200 combo actions",
      "condition": "${cycle < max_cycles}",
      "steps": [
        {
          "type": "if",
          "label": "Tap Lock every 5 seconds",
          "condition": "${cycle % 10 == 0}",
          "then": [
            {
              "type": "tap",
              "point": "${lock_point}",
              "duration_ms": "${lock_tap_ms}"
            }
          ],
          "else": []
        },
        {
          "type": "skill_check",
          "label": "Check S usable",
          "roi": "${s_roi}",
          "model": "default",
          "skill": "S",
          "threshold": 0,
          "output": "${skill_state}"
        },
        {
          "type": "if",
          "condition": "${skill_state.state == 'usable'}",
          "then": [
            {
              "type": "tap",
              "point": "${skill_state.point}",
              "duration_ms": "${s_tap_ms}"
            }
          ],
          "else": [],
          "label": "Use S"
        },
        {
          "type": "if",
          "label": "AAA,HA,E,A",
          "condition": "${combo_step < 3 || combo_step == 5}",
          "then": [
            {
              "type": "if",
              "label": "Select the tap time for this A position",
              "condition": "${combo_step == 0}",
              "then": [
                {
                  "type": "assign",
                  "target": "${current_tap_ms}",
                  "value": "${a_1_tap_ms}"
                }
              ],
              "else": [
                {
                  "type": "if",
                  "condition": "${combo_step == 1}",
                  "then": [
                    {
                      "type": "assign",
                      "target": "${current_tap_ms}",
                      "value": "${a_2_tap_ms}"
                    }
                  ],
                  "else": [
                    {
                      "type": "if",
                      "condition": "${combo_step == 2}",
                      "then": [
                        {
                          "type": "assign",
                          "target": "${current_tap_ms}",
                          "value": "${a_3_tap_ms}"
                        }
                      ],
                      "else": [
                        {
                          "type": "assign",
                          "target": "${current_tap_ms}",
                          "value": "${a_4_tap_ms}"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "skill_check",
              "roi": "${a_roi}",
              "model": "default",
              "skill": "A",
              "threshold": 0,
              "output": "${skill_state}"
            },
            {
              "type": "if",
              "condition": "${skill_state.state == 'usable'}",
              "then": [
                {
                  "type": "tap",
                  "point": "${skill_state.point}",
                  "duration_ms": "${current_tap_ms}"
                },
                {
                  "type": "if",
                  "condition": "${combo_step == 5}",
                  "then": [
                    {
                      "type": "assign",
                      "target": "${combo_step}",
                      "value": 0
                    }
                  ],
                  "else": [
                    {
                      "type": "assign",
                      "target": "${combo_step}",
                      "value": "${combo_step + 1}"
                    }
                  ]
                }
              ],
              "else": [
                {
                  "type": "assign",
                  "label": "Restart combo",
                  "target": "${combo_step}",
                  "value": 0
                }
              ]
            }
          ],
          "else": [
            {
              "type": "if",
              "label": "Heavy A at combo step 3",
              "condition": "${combo_step == 3}",
              "then": [
                {
                  "type": "skill_check",
                  "roi": "${a_roi}",
                  "model": "default",
                  "skill": "A",
                  "threshold": 0,
                  "output": "${skill_state}"
                },
                {
                  "type": "if",
                  "condition": "${skill_state.state == 'usable'}",
                  "then": [
                    {
                      "type": "tap",
                      "point": "${a_point}",
                      "duration_ms": "${heavy_a_tap_ms}"
                    },
                    {
                      "type": "assign",
                      "target": "${combo_step}",
                      "value": 4
                    }
                  ],
                  "else": [
                    {
                      "type": "assign",
                      "label": "Restart combo",
                      "target": "${combo_step}",
                      "value": 0
                    }
                  ]
                }
              ],
              "else": [
                {
                  "type": "skill_check",
                  "label": "E at combo step 4",
                  "roi": "${e_roi}",
                  "model": "default",
                  "skill": "E",
                  "threshold": 0,
                  "output": "${skill_state}"
                },
                {
                  "type": "if",
                  "condition": "${skill_state.state == 'usable'}",
                  "then": [
                    {
                      "type": "tap",
                      "point": "${skill_state.point}",
                      "duration_ms": "${e_tap_ms}"
                    },
                    {
                      "type": "assign",
                      "target": "${combo_step}",
                      "value": 5
                    }
                  ],
                  "else": [
                    {
                      "type": "assign",
                      "label": "Restart combo",
                      "target": "${combo_step}",
                      "value": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "assign",
          "target": "${cycle}",
          "value": "${cycle + 1}",
          "label": "cycle ++"
        },
        {
          "type": "wait",
          "wait_ms": 100,
          "label": "wait 100 ms"
        }
      ]
    }
  ]
}
