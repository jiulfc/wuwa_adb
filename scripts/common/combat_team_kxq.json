{
  "version": 3,
  "label": "Loop Katixiya and Qianxiao, switching every 16 seconds",
  "vars": {
    "switch_role_point": [2870, 360]
  },
  "steps": [
    {
      "type": "while",
      "label": "Alternate Katixiya and Qianxiao",
      "condition": true,
      "steps": [
        {
          "type": "run_for",
          "label": "Run Katixiya for 16 seconds",
          "duration_ms": 16000,
          "steps": [
            {
              "type": "script",
              "label": "Katixiya combat",
              "script_name": "combat_role_katixiya.json"
            }
          ]
        },
        {
          "type": "tap",
          "label": "Switch to Qianxiao",
          "point": "${switch_role_point}",
          "duration_ms": 100
        },
        {
          "type": "wait",
          "label": "Wait after switching to Qianxiao",
          "wait_ms": 500
        },
        {
          "type": "run_for",
          "label": "Run Qianxiao for 16 seconds",
          "duration_ms": 16000,
          "steps": [
            {
              "type": "script",
              "label": "Qianxiao combat",
              "script_name": "combat_role_qianxiao.json"
            }
          ]
        },
        {
          "type": "tap",
          "label": "Switch to Katixiya",
          "point": "${switch_role_point}",
          "duration_ms": 100
        },
        {
          "type": "wait",
          "label": "Wait after switching to Katixiya",
          "wait_ms": 500
        }
      ]
    }
  ]
}
