{
  "version": 3,
  "label": "opportunistic S; priority R, E, then A,A,A,A,A, Heavy A",
  "vars": {
    "cycle": 0,
    "max_cycles": 200,
    "combo_step": 0,
    "skill_state": null,
    "lock_point": [955, 1220],
    "r_roi": [2124, 1084, 120, 120],
    "e_roi": [2276, 1188, 144, 144],
    "s_roi": [2276, 936, 72, 72],
    "a_roi": [2448, 1000, 240, 240]
  },
  "steps": [
    {
      "type": "while",
      "label": "Run at most 200 combo actions",
      "condition": "${cycle < max_cycles}",
      "steps": [
        {
          "type": "if",
          "label": "Tap Lock every 5 seconds",
          "condition": "${cycle % 10 == 0}",
          "then": [
            { "type": "tap", "point": "${lock_point}", "duration_ms": 100 }
          ],
          "else": []
        },
        {
          "type": "skill_check",
          "label": "Check S usable",
          "roi": "${s_roi}",
          "model": "default",
          "skill": "S",
          "threshold": 0,
          "output": "${skill_state}"
        },
        {
          "type": "if",
          "label": "Use S without changing the combo",
          "condition": "${skill_state.state == 'usable'}",
          "then": [
            {
              "type": "tap",
              "point": "${skill_state.point}",
              "duration_ms": 100
            }
          ],
          "else": []
        },
        {
          "type": "skill_check",
          "label": "Check R usable",
          "roi": "${r_roi}",
          "model": "default",
          "skill": "R",
          "threshold": 0,
          "output": "${skill_state}"
        },
        {
          "type": "if",
          "label": "Use R first",
          "condition": "${skill_state.state == 'usable'}",
          "then": [
            {
              "type": "tap",
              "point": "${skill_state.point}",
              "duration_ms": 100
            }
          ],
          "else": [
            {
              "type": "skill_check",
              "label": "Check E usable",
              "roi": "${e_roi}",
              "model": "default",
              "skill": "E",
              "threshold": 0,
              "output": "${skill_state}"
            },
            {
              "type": "if",
              "label": "Use E second",
              "condition": "${skill_state.state == 'usable'}",
              "then": [
                {
                  "type": "tap",
                  "point": "${skill_state.point}",
                  "duration_ms": 100
                }
              ],
              "else": [
                {
                  "type": "skill_check",
                  "label": "Check A / Heavy A usable",
                  "roi": "${a_roi}",
                  "model": "default",
                  "skill": "A",
                  "threshold": 0,
                  "output": "${skill_state}"
                },
                {
                  "type": "if",
                  "label": "Use A or restart",
                  "condition": "${skill_state.state == 'usable'}",
                  "then": [
                    {
                      "type": "if",
                      "label": "A at combo steps 0 through 4",
                      "condition": "${combo_step < 5}",
                      "then": [
                        {
                          "type": "tap",
                          "point": "${skill_state.point}",
                          "duration_ms": 100
                        },
                        {
                          "type": "assign",
                          "target": "${combo_step}",
                          "value": "${combo_step + 1}"
                        }
                      ],
                      "else": [
                        {
                          "type": "tap",
                          "label": "Heavy A at combo step 5",
                          "point": "${skill_state.point}",
                          "duration_ms": 1200
                        },
                        {
                          "type": "assign",
                          "label": "Combo complete",
                          "target": "${combo_step}",
                          "value": 0
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "type": "assign",
                      "label": "Restart combo",
                      "target": "${combo_step}",
                      "value": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        { "type": "assign", "target": "${cycle}", "value": "${cycle + 1}" },
        { "type": "wait", "wait_ms": 100 }
      ]
    }
  ]
}
