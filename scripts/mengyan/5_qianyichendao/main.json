{
  "version": 3,
  "vars": {
    "counter": 0,
    "stop_text": ""
  },
  "steps": [
    {
      "type": "while",
      "condition": "${counter < 1}",
      "steps": [
        {
          "type": "assign",
          "target": "${counter}",
          "value": "${counter + 1}"
        },
        {
          "type": "script",
          "script_name": "prepare.json",
          "label": "Prepare"
        },
        {
          "type": "run_until",
          "check_every_ms": 500,
          "timeout_ms": 30000,
          "until": "${stop_text contains '已' || stop_text contains '己清'}",
          "check": [
            {
              "type": "ocr_text",
              "roi": [
                222,
                397,
                319,
                49
              ],
              "output": "${stop_text}",
              "label": "stop text check"
            }
          ],
          "steps": [
            {
              "type": "script",
              "script_name": "../../common/combat_role_katixiya.json",
              "label": "Battle"
            }
          ],
          "label": "run until stop text"
        },
        {
          "type": "script",
          "script_name": "pickup.json",
          "label": "Pickup"
        },
        {
          "type": "script",
          "script_name": "finish.json",
          "label": "Finish"
        }
      ],
      "label": "Loop"
    }
  ]
}