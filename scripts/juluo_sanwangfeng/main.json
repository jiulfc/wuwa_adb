{
  "version": 3,
  "vars": {
    "counter": 0,
    "stop_text": ""
  },
  "steps": [
    {
      "type": "while",
      "condition": "${counter < 1}",
      "steps": [
        {
          "type": "assign",
          "target": "${counter}",
          "value": "${counter + 1}",
          "label": "counter ++"
        },
        {
          "type": "script",
          "script_name": "prepare.json",
          "label": "prepare"
        },
        {
          "type": "monitor",
          "interval_ms": 500,
          "timeout_ms": 30000,
          "until": "${stop_text contains '已' || stop_text contains '清'}",
          "check": [
            {
              "type": "ocr_text",
              "roi": [
                222,
                397,
                319,
                49
              ],
              "output": "${stop_text}"
            }
          ],
          "steps": [
            {
              "type": "script",
              "script_name": "../common/combat_role_katixiya.json"
            }
          ],
          "label": "if not finish, combat until finish"
        },
        {
          "type": "script",
          "script_name": "pickup.json",
          "label": "pickup"
        },
        {
          "type": "script",
          "script_name": "finish.json",
          "label": "done"
        }
      ]
    }
  ]
}