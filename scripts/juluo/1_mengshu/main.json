{
  "version": 3,
  "vars": {
    "counter": 0,
    "stop_text": "",
    "pickup_text": "",
    "pickup_point": [2096.5, 612]
  },
  "steps": [
    {
      "type": "while",
      "condition": "${counter < 1}",
      "steps": [
        {
          "type": "assign",
          "target": "${counter}",
          "value": "${counter + 1}"
        },
        {
          "type": "script",
          "script_name": "prepare.json"
        },
        {
          "type": "run_until",
          "check_every_ms": 500,
          "timeout_ms": 300000,
          "until": "${stop_text contains '已' || stop_text contains '己清'}",
          "check": [
            {
              "type": "ocr_text",
              "roi": [222, 397, 319, 49],
              "output": "${stop_text}"
            }
          ],
          "steps": [
            {
              "type": "script",
              "script_name": "../../common/combat_role_katixiya.json"
            }
          ]
        },
        {
          "type": "assign",
          "target": "${pickup_point}",
          "value": [2096.5, 612]
        },
        {
          "type": "ocr_text",
          "roi": [2041, 589, 111, 46],
          "output": "${pickup_text}"
        },
        {
          "type": "if",
          "condition": "${!(pickup_text contains '吸收')}",
          "then": [
            {
              "type": "ocr_text",
              "roi": [2041, 715, 111, 46],
              "output": "${pickup_text}"
            },
            {
              "type": "assign",
              "target": "${pickup_point}",
              "value": [2096.5, 738]
            }
          ]
        },
        {
          "type": "if",
          "condition": "${pickup_text contains '吸收'}",
          "then": [
            {
              "type": "tap",
              "point": "${pickup_point}",
              "duration_ms": 100
            }
          ],
          "else": [
            {
              "type": "script",
              "script_name": "pickup_prepare.json"
            },
            {
              "type": "script",
              "script_name": "pickup.json"
            }
          ]
        },
        {
          "type": "wait",
          "wait_ms": 2000
        },
        {
          "type": "script",
          "script_name": "finish.json"
        }
      ]
    }
  ]
}
