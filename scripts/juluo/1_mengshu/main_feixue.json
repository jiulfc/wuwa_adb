{
  "version": 3,
  "vars": {
    "counter": 0,
    "stop_text": ""
  },
  "steps": [
    {
      "type": "while",
      "condition": "${counter < 1}",
      "steps": [
        {
          "type": "assign",
          "target": "${counter}",
          "value": "${counter + 1}"
        },
        {
          "type": "script",
          "script_name": "prepare_feixue.json"
        },
        {
          "type": "run_until",
          "check_every_ms": 500,
          "timeout_ms": 300000,
          "until": "${stop_text contains '已' || stop_text contains '己清'}",
          "check": [
            {
              "type": "ocr_text",
              "roi": [222, 397, 319, 49],
              "output": "${stop_text}"
            }
          ],
          "steps": [
            {
              "type": "script",
              "script_name": "../../common/combat_role_feixue.json"
            }
          ]
        },
        {
          "type": "script",
          "script_name": "pickup.json"
        },
        {
          "type": "wait",
          "wait_ms": 2000
        },
        {
          "type": "script",
          "script_name": "../../common/route_to_quan_xi_huan_tong/main.json"
        },
        {
          "type": "wait",
          "wait_ms": 2000
        }
      ]
    }
  ]
}
