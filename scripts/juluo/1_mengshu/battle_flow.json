{
  "version": 3,
  "vars": {
    "counter": 0,
    "stop_text": ""
  },
  "steps": [
    {
      "type": "while",
      "condition": "${counter < 1}",
      "steps": [
        {
          "type": "assign",
          "target": "${counter}",
          "value": "${counter + 1}"
        },
        {
          "type": "script",
          "script_name": "battle.json"
        },
        {
          "type": "wait",
          "wait_ms": 2000
        },
        {
          "type": "script",
          "script_name": "../../common/pickup.json"
        },
        {
          "type": "wait",
          "wait_ms": 2000
        },
        {
          "type": "script",
          "script_name": "../../common/route_to_quan_xi_huan_tong/main.json"
        },
        {
          "type": "wait",
          "wait_ms": 2000
        }
      ]
    }
  ]
}
